# ===========================================
# VARIABLES DE ENTORNO - DETECTOR DE ESTRÉS
# ===========================================

# TensorFlow Configuration
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

# Audio Configuration
DURATION=10
SAMPLE_RATE=22050
MFCC_FEATURES=40
AUDIO_DEVICE=default
AUDIO_CHANNELS=1
AUDIO_DTYPE=float32

# Video Configuration
VIDEO_DEVICE=0
VIDEO_FPS=30
VIDEO_CODEC=mp4v

# File Paths
MODEL_PATH=models/modelo_deteccion_estres.keras
DATASET_PATH=processed_dataset.npz
DOWNLOAD_DIR=dataset_audios
RECORDINGS_DIR=recordings
FILENAME=recordings/audio.wav

# Dataset Configuration
DATASET_URL=https://datasets-server.huggingface.co/rows?dataset=macabdul9%2FStressDetection_MIRSD&config=default&split=test&offset=0&length=100

# Stress Detection Thresholds
STRESS_THRESHOLD=0.6
STRESS_THRESHOLD_LOW=0.3
STRESS_THRESHOLD_MEDIUM=0.6
STRESS_THRESHOLD_HIGH=0.8
STRESS_THRESHOLD_CRITICAL=1.0

# Model Configuration
STRESS_MODEL=models/modelo_deteccion_estres.keras

# Runtime (Render)
PYTHON_VERSION=3.13.4
PYTHONPATH=StressDetector/src
